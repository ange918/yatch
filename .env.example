# Copier ce fichier vers .env pour un essai local. Ne jamais y mettre de vraie
# clé dans git. Sur Vercel : Project → Settings → Environment Variables.
# Aucune valeur ci-dessous n'est un secret.

# Destinataire des demandes. Si la variable est absente, la fonction utilise
# contact@krediiwelt.com.
CONTACT_TO_EMAIL=contact@krediiwelt.com

# --- Resend (prioritaire dès que RESEND_API_KEY est renseignée) ---
# Créer la clé dans le tableau de bord Resend, après vérification du domaine.
RESEND_API_KEY=
# Expéditeur. L'adresse doit appartenir au domaine vérifié chez Resend.
# Obligatoire si RESEND_API_KEY est défini.
MAIL_FROM="Finanzkredit <contact@krediiwelt.com>"

# --- SMTP (utilisé seulement si RESEND_API_KEY est vide) ---
# Les quatre variables sont requises. Port 587 = STARTTLS, port 465 = TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Avec SMTP, MAIL_FROM est facultatif : à défaut, SMTP_USER sert d'expéditeur
# s'il s'agit d'une adresse e-mail.
